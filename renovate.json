{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>KellanStevens/ci//renovate/default"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "actionlint in lint.yml: the release tag, and the SHA-256 of its linux_amd64 archive",
      "managerFilePatterns": ["/^\\.github/workflows/lint\\.yml$/"],
      "matchStrings": [
        "VERSION: (?<currentValue>v\\S+)\\s+SHA256: (?<currentDigest>[0-9a-f]{64})"
      ],
      "depNameTemplate": "rhysd/actionlint",
      "datasourceTemplate": "github-release-attachments"
    },
    {
      "customType": "regex",
      "description": "Semgrep in static-analysis.yml: the version on the line after the renovate comment",
      "managerFilePatterns": ["/^\\.github/workflows/static-analysis\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+VERSION: (?<currentValue>\\S+)"
      ]
    }
  ]
}
